# Configuration reference: Django reads terminal/hosting environment variables.
# This project does not automatically load .env files.
# Keep real credentials in your private .env or Render environment settings.
#
# LOCAL DEVELOPMENT (replace the production values below with these):
# DJANGO_SETTINGS_MODULE=config.settings.development
# DJANGO_SECRET_KEY=local-development-only-change-me
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Development settings already allow localhost and 127.0.0.1.
#
# SQLite (default): remove or leave POSTGRES_DB empty:
# POSTGRES_DB=
# No other POSTGRES_* variables are needed for SQLite.
#
# Optional local PostgreSQL (create this database first):
# POSTGRES_DB=clinic_booking
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-local-database-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=disable
# Remove POSTGRES_CHANNEL_BINDING for a local database without channel binding.
#
# PRODUCTION / RENDER WITH NEON:
# Replace the placeholders with your own values; keep real secrets out of Git.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_ALLOWED_HOSTS=your-service.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com


POSTGRES_DB=your-database-name
POSTGRES_USER=your-database-user
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_HOST=your-neon-host.neon.tech
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
POSTGRES_CHANNEL_BINDING=require

