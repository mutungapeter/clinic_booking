{
  "info": {
    "_postman_id": "f35e0194-2b1a-4b26-9b41-e503152cb006",
    "name": "Clinic Booking API — Recruiter Walkthrough",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Import the accompanying environment and select it. Run only the '01 - Booking walkthrough' folder, in its saved order, with one iteration. Requires a running application with migrated and seeded data. Automatically saves tokens and IDs, chooses a future weekday, and verifies booking, rescheduling, cancellation, and error responses. Finishes by cancelling its bookings; cancelled history remains. Optional registration is separate."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Response follows the documented JSON contract\", function () {",
          "    const payload = pm.response.json();",
          "    pm.expect(payload.status).to.equal(pm.response.code);",
          "    if (pm.response.code >= 400) {",
          "        pm.expect(payload.message).to.equal(null);",
          "        pm.expect(payload.data).to.equal(null);",
          "        pm.expect(payload.error).to.be.a(\"string\");",
          "    } else {",
          "        pm.expect(Object.prototype.hasOwnProperty.call(payload, \"error\")).to.equal(false);",
          "        if (pm.request.method === \"GET\") { pm.expect(payload.message).to.equal(null); }",
          "    }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Booking walkthrough",
      "description": "Run this folder in saved order, one iteration. Do not shuffle. Uses only synthetic test bookings.",
      "item": [
        {
          "name": "01 - Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/auth/login",
            "description": "Log in with the documented seeded patient. Clears stale run state and calculates a future weekday in Nairobi.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "[\"access_token\", \"refresh_token\", \"doctor_id\", \"patient_id\", \"appointment_id\", \"rebooked_id\", \"starts_at\", \"reschedule_starts_at\"].forEach(function (key) { pm.environment.unset(key); });",
                  "pm.environment.set(\"search_attempt\", \"0\");",
                  "const configuredDate = pm.environment.get(\"test_date\");",
                  "if (configuredDate && !/^\\d{4}-\\d{2}-\\d{2}$/.test(configuredDate)) {",
                  "    pm.execution.setNextRequest(null);",
                  "    pm.execution.skipRequest();",
                  "    throw new Error(\"test_date must use YYYY-MM-DD, or leave it empty for automatic selection.\");",
                  "}",
                  "if (configuredDate) {",
                  "    pm.environment.set(\"availability_date\", configuredDate);",
                  "} else {",
                  "    const day = new Date(Date.now() + 3 * 60 * 60 * 1000);",
                  "    day.setUTCDate(day.getUTCDate() + 1);",
                  "    while (day.getUTCDay() === 0 || day.getUTCDay() === 6) { day.setUTCDate(day.getUTCDate() + 1); }",
                  "    pm.environment.set(\"availability_date\", day.toISOString().slice(0, 10));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.equal(200); });",
                  "if (pm.response.code !== 200) {",
                  "    pm.execution.setNextRequest(null);",
                  "    throw new Error(\"Unexpected response. Check base_url, seeded credentials, and response error.\");",
                  "}",
                  "const body = pm.response.json();",
                  "pm.test(\"Both tokens returned\", function () {",
                  "    pm.expect(body.data.access).to.be.a(\"string\");",
                  "    pm.expect(body.data.refresh).to.be.a(\"string\");",
                  "});",
                  "pm.environment.set(\"access_token\", body.data.access);",
                  "pm.environment.set(\"refresh_token\", body.data.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Refresh access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/auth/token/refresh",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.equal(200); });",
                  "if (pm.response.code !== 200) {",
                  "    pm.execution.setNextRequest(null);",
                  "    throw new Error(\"Unexpected response. Check base_url, seeded credentials, and response error.\");",
                  "}",
                  "const body = pm.response.json();",
                  "pm.test(\"New access token returned\", function () { pm.expect(body.data.access).to.be.a(\"string\"); });",
                  "pm.environment.set(\"access_token\", body.data.access);",
                  "if (body.data.refresh) { pm.environment.set(\"refresh_token\", body.data.refresh); }"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - List doctors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/doctors",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.equal(200); });",
                  "if (pm.response.code !== 200) {",
                  "    pm.execution.setNextRequest(null);",
                  "    throw new Error(\"Unexpected response. Check base_url, seeded credentials, and response error.\");",
                  "}",
                  "const body = pm.response.json();",
                  "pm.test(\"At least one active doctor exists\", function () { pm.expect(body.data.results.length > 0).to.equal(true); });",
                  "if (!body.data.results.length) {",
                  "    pm.execution.setNextRequest(null);",
                  "    throw new Error(\"No doctors found. Run seed_doctors before the collection.\");",
                  "}",
                  "pm.environment.set(\"doctor_id\", body.data.results[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Find two available slots",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/doctors/{{doctor_id}}/availability?date={{availability_date}}",
            "description": "Finds two free future slots. In Collection Runner, searches up to 14 consecutive dates if needed. When using Send manually, resend this request after an empty day; it advances availability_date."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.equal(200); });",
                  "if (pm.response.code !== 200) {",
                  "    pm.execution.setNextRequest(null);",
                  "    throw new Error(\"Unexpected response. Check base_url, seeded credentials, and response error.\");",
                  "}",
                  "const body = pm.response.json();",
                  "const slots = body.data.slots;",
                  "if (slots.length >= 2) {",
                  "    pm.test(\"Two valid slots and Kenyan display labels returned\", function () {",
                  "        pm.expect(Date.parse(slots[0].starts_at) > Date.now() + 60 * 60 * 1000).to.equal(true);",
                  "        pm.expect(slots[0].display_time).to.be.a(\"string\");",
                  "    });",
                  "    pm.environment.set(\"starts_at\", slots[0].starts_at);",
                  "    pm.environment.set(\"reschedule_starts_at\", slots[1].starts_at);",
                  "} else {",
                  "    const attempts = Number(pm.environment.get(\"search_attempt\") || 0) + 1;",
                  "    pm.environment.set(\"search_attempt\", String(attempts));",
                  "    if (attempts >= 14 || pm.environment.get(\"test_date\")) {",
                  "        pm.test(\"Selected date window has two free slots\", function () { pm.expect(slots.length >= 2).to.equal(true); });",
                  "        pm.execution.setNextRequest(null);",
                  "        throw new Error(\"No two free slots found. Review working hours or choose another test_date and rerun.\");",
                  "    }",
                  "    const day = new Date(pm.environment.get(\"availability_date\") + \"T12:00:00Z\");",
                  "    day.setUTCDate(day.getUTCDate() + 1);",
                  "    pm.environment.set(\"availability_date\", day.toISOString().slice(0, 10));",
                  "    pm.execution.setNextRequest(pm.info.requestId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Book appointment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/appointments",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor_id\": \"{{doctor_id}}\",\n  \"starts_at\": \"{{starts_at}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.expect(pm.response.code).to.equal(201); });",
                  "if (pm.response.code !== 201) {",
                  "    pm.execution.setNextRequest(null);",
                  "    throw new Error(\"Unexpected response. Check base_url, seeded credentials, and response error.\");",
                  "}",
                  "const body = pm.response.json();",
                  "pm.test(\"Booked appointment includes display time\", function () {",
                  "    pm.expect(body.data.status).to.equal(\"BOOKED\");",
                  "    pm.expect(body.data.display_time).to.be.a(\"string\");",
                  "});",
                  "pm.environment.set(\"appointment_id\", body.data.id);",
                  "pm.environment.set(\"patient_id\", body.data.patient_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Confirm booked slot is unavailable",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/doctors/{{doctor_id}}/availability?date={{availability_date}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.equal(200); });",
                  "if (pm.response.code !== 200) {",
                  "    pm.execution.setNextRequest(null);",
                  "    throw new Error(\"Unexpected response. Check base_url, seeded credentials, and response error.\");",
                  "}",
                  "const body = pm.response.json();",
                  "function sameInstant(left, right) { return Date.parse(left) === Date.parse(right); }",
                  "pm.test(\"Original slot is excluded\", function () {",
                  "    pm.expect(body.data.slots.some(function (slot) { return sameInstant(slot.starts_at, pm.environment.get(\"starts_at\")); })).to.equal(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "07 - Reject duplicate booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/appointments",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor_id\": \"{{doctor_id}}\",\n  \"starts_at\": \"{{starts_at}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", function () { pm.expect(pm.response.code).to.equal(409); });",
                  "if (pm.response.code !== 409) {",
                  "    pm.execution.setNextRequest(null);",
                  "    throw new Error(\"Unexpected response. Check base_url, seeded credentials, and response error.\");",
                  "}",
                  "const body = pm.response.json();",
                  "pm.test(\"Duplicate booking has a meaningful error\", function () { pm.expect(body.error.includes(\"already booked\")).to.equal(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "08 - Reject rescheduling to the same time",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/appointments/{{appointment_id}}/reschedule",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"starts_at\": \"{{starts_at}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.expect(pm.response.code).to.equal(400); });",
                  "if (pm.response.code !== 400) {",
                  "    pm.execution.setNextRequest(null);",
                  "    throw new Error(\"Unexpected response. Check base_url, seeded credentials, and response error.\");",
                  "}",
                  "const body = pm.response.json();",
                  "pm.test(\"Same-time error explains what to do\", function () { pm.expect(body.error.includes(\"already scheduled\")).to.equal(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "09 - Reject invalid date format",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/doctors/{{doctor_id}}/availability?date=2030%2F01%2F07",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.expect(pm.response.code).to.equal(400); });",
                  "if (pm.response.code !== 400) {",
                  "    pm.execution.setNextRequest(null);",
                  "    throw new Error(\"Unexpected response. Check base_url, seeded credentials, and response error.\");",
                  "}",
                  "const body = pm.response.json();",
                  "pm.test(\"Date error includes the required format\", function () { pm.expect(body.error.includes(\"YYYY-MM-DD\")).to.equal(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "10 - Reschedule appointment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/appointments/{{appointment_id}}/reschedule",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"starts_at\": \"{{reschedule_starts_at}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.equal(200); });",
                  "if (pm.response.code !== 200) {",
                  "    pm.execution.setNextRequest(null);",
                  "    throw new Error(\"Unexpected response. Check base_url, seeded credentials, and response error.\");",
                  "}",
                  "const body = pm.response.json();",
                  "function sameInstant(left, right) { return Date.parse(left) === Date.parse(right); }",
                  "pm.test(\"Same appointment moved to selected destination\", function () {",
                  "    pm.expect(body.data.id).to.equal(pm.environment.get(\"appointment_id\"));",
                  "    pm.expect(sameInstant(body.data.starts_at, pm.environment.get(\"reschedule_starts_at\"))).to.equal(true);",
                  "    pm.expect(body.data.status).to.equal(\"BOOKED\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "11 - Verify rescheduling released original slot",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/doctors/{{doctor_id}}/availability?date={{availability_date}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.equal(200); });",
                  "if (pm.response.code !== 200) {",
                  "    pm.execution.setNextRequest(null);",
                  "    throw new Error(\"Unexpected response. Check base_url, seeded credentials, and response error.\");",
                  "}",
                  "const body = pm.response.json();",
                  "function sameInstant(left, right) { return Date.parse(left) === Date.parse(right); }",
                  "pm.test(\"Original slot free and destination occupied\", function () {",
                  "    pm.expect(body.data.slots.some(function (slot) { return sameInstant(slot.starts_at, pm.environment.get(\"starts_at\")); })).to.equal(true);",
                  "    pm.expect(body.data.slots.some(function (slot) { return sameInstant(slot.starts_at, pm.environment.get(\"reschedule_starts_at\")); })).to.equal(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "12 - List my upcoming appointments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/patients/{{patient_id}}/appointments",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.equal(200); });",
                  "if (pm.response.code !== 200) {",
                  "    pm.execution.setNextRequest(null);",
                  "    throw new Error(\"Unexpected response. Check base_url, seeded credentials, and response error.\");",
                  "}",
                  "const body = pm.response.json();",
                  "pm.test(\"Results are upcoming, booked, sorted, and readable\", function () {",
                  "    const results = body.data.results;",
                  "    pm.expect(body.data.count > 0).to.equal(true);",
                  "    results.forEach(function (appointment, index) {",
                  "        pm.expect(appointment.status).to.equal(\"BOOKED\");",
                  "        pm.expect(appointment.patient_id).to.equal(pm.environment.get(\"patient_id\"));",
                  "        pm.expect(Date.parse(appointment.starts_at) > Date.now()).to.equal(true);",
                  "        pm.expect(appointment.display_time).to.be.a(\"string\");",
                  "        if (index > 0) { pm.expect(Date.parse(results[index - 1].starts_at) <= Date.parse(appointment.starts_at)).to.equal(true); }",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "13 - Cancel appointment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/appointments/{{appointment_id}}/cancel",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Recruiter demo: testing cancellation.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.equal(200); });",
                  "if (pm.response.code !== 200) {",
                  "    pm.execution.setNextRequest(null);",
                  "    throw new Error(\"Unexpected response. Check base_url, seeded credentials, and response error.\");",
                  "}",
                  "const body = pm.response.json();",
                  "pm.test(\"Appointment is cancelled\", function () { pm.expect(body.data.status).to.equal(\"CANCELLED\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "14 - Verify cancellation released destination",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/doctors/{{doctor_id}}/availability?date={{availability_date}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.equal(200); });",
                  "if (pm.response.code !== 200) {",
                  "    pm.execution.setNextRequest(null);",
                  "    throw new Error(\"Unexpected response. Check base_url, seeded credentials, and response error.\");",
                  "}",
                  "const body = pm.response.json();",
                  "function sameInstant(left, right) { return Date.parse(left) === Date.parse(right); }",
                  "pm.test(\"Cancelled slot is available again\", function () {",
                  "    pm.expect(body.data.slots.some(function (slot) { return sameInstant(slot.starts_at, pm.environment.get(\"reschedule_starts_at\")); })).to.equal(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "15 - Reject repeated cancellation",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/appointments/{{appointment_id}}/cancel",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Repeated cancellation should fail.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
